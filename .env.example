# Server only. Never use VITE_ for secrets.
# Required for chat; all other dashboard features work without a key.
GEMINI_API_KEY=
# Response Generator model; must support JSON Schema structured outputs.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional Request Understanding model; defaults to GEMINI_MODEL.
# GEMINI_UNDERSTANDING_MODEL=gemini-3.1-flash-lite
# The Vite development API proxy reads this port too.
PORT=8787
# Optional listen address; defaults to loopback.
# HOST=127.0.0.1
