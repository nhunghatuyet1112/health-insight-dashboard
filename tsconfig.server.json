{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "src/features/health/model.ts",
    "src/features/health/demo.ts",
    "src/features/health/engine.ts",
    "src/features/assistant/*.ts"
  ]
}
